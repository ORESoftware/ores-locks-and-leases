schema_version = 1
tenant_id = "replace-with-tenant"
namespace = "locks"
language = "erlang"
tenancy_class = "tenant_dedicated"

[build]
project = "./critical-worker"
out_dir = "dist-critical"

[artifact]
directory = "dist-critical"
# Optional exact pin after a reproducible build:
# build_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

[deployment]
id = "ores-locks-critical-sections"
