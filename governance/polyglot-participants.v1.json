      "tjsvStepId": "typescript"
    },
    {
      "id": "go",
      "sourceDir": "src/go",
      "boundaryLanguage": "go",
      "ciJob": "go",
      "contractRuntimeJob": "go",
      "tjsvStepId": "go"
    },
    {
      "id": "dart",
      "sourceDir": "src/dart",
      "boundaryLanguage": "dart",
      "ciJob": "dart",
      "contractRuntimeJob": "dart",
