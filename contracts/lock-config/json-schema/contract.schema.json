{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-locks-and-leases/contracts/lock-config/json-schema/contract.schema.json",
  "$comment": "`.ores-lock.toml` normalized contract — independent JSON Schema authority. Peer of contracts/lock-config/typespec/main.tsp; neither is generated from the other.",
  "x-ores-namespace": "Ores.LocksAndLeases.Config",
  "$defs": {
    "LockConfigSchemaVersion": {
      "type": "string",
      "enum": [
        "ores.lock.config.v1"
      ]
    },
    "EnvKind": {
      "type": "string",
      "enum": [
        "string",
        "boolean",
        "integer",
        "double",
        "url",
        "path"
      ]
    },
    "OuterLeaseAuthority": {
      "type": "string",
      "enum": [
        "fiducia",
        "cloudflare_durable_object",
        "beamscale_critical_section",
        "redis"
      ]
    },
    "EnvKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "LockProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,126}[a-z0-9])?$"
    },
    "EnvBinding": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/EnvKey"
        },
        "kind": {
          "$ref": "#/$defs/EnvKind"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "kind",
        "required",
        "secret",
        "purpose"
      ]
    },
    "ProviderSelection": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "local_file": {
          "type": "boolean"
        },
        "fiducia": {
          "type": "boolean",
          "description": "Historical v1 name for the managed outer lease layer. outer_authority chooses its concrete backend; omission preserves Fiducia behavior."
        },
        "pg_advisory": {
          "type": "boolean"
        }
      },
      "required": [
        "local_file",
        "fiducia",
        "pg_advisory"
      ]
    },
    "LocalFileProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "root_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "require_existing_root": {
          "type": "boolean"
        }
      },
      "required": [
        "root_env",
        "require_existing_root"
      ]
    },
    "FiduciaProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "endpoint_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "auth_token_env": {
          "$ref": "#/$defs/EnvKey"
        }
      },
      "required": [
        "endpoint_env",
        "auth_token_env"
      ]
    },
    "CloudflareDurableObjectProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "endpoint_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "api_token_env": {
          "$ref": "#/$defs/EnvKey"
        }
      },
      "required": [
        "endpoint_env",
        "api_token_env"
      ]
    },
    "RedisProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "endpoint_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "auth_token_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "endpoint_env",
        "auth_token_env"
      ]
    },
    "PostgresLockScope": {
      "type": "string",
      "enum": [
        "transaction",
        "session"
      ]
    },
    "PostgresProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "database_url_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "scope": {
          "$ref": "#/$defs/PostgresLockScope"
        }
      },
      "required": [
        "database_url_env",
        "scope"
      ]
    },
    "LockProfileConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/LockProfileId"
        },
        "wait": {
          "type": "boolean"
        },
        "wait_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "retry_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "Managed outer-lease TTL. Required whenever providers.fiducia=true, regardless of concrete outer_authority."
        },
        "renew_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200000,
          "description": "Maintained-lease renewal interval. When present, runtime policy also requires this to be <= ttl_ms / 2."
        },
        "providers": {
          "$ref": "#/$defs/ProviderSelection"
        },
        "outer_authority": {
          "$ref": "#/$defs/OuterLeaseAuthority"
        },
        "local_file": {
          "$ref": "#/$defs/LocalFileProviderConfig"
        },
        "fiducia": {
          "$ref": "#/$defs/FiduciaProviderConfig"
        },
        "cloudflare_durable_object": {
          "$ref": "#/$defs/CloudflareDurableObjectProviderConfig"
        },
        "redis": {
          "$ref": "#/$defs/RedisProviderConfig"
        },
        "postgres": {
          "$ref": "#/$defs/PostgresProviderConfig"
        },
        "beamscale_critical_section": {
          "$ref": "#/$defs/BeamScaleCriticalSectionProviderConfig"
        }
      },
      "required": [
        "profile_id",
        "wait",
        "wait_timeout_ms",
        "retry_interval_ms",
        "providers"
      ]
    },
    "OresLockConfigV1": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/LockConfigSchemaVersion"
        },
        "default_profile": {
          "$ref": "#/$defs/LockProfileId"
        },
        "selected_profile_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvBinding"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockProfileConfig"
          }
        }
      },
      "required": [
        "schema_version",
        "default_profile",
        "env",
        "profiles"
      ]
    },
    "BeamScaleCriticalSectionProviderConfig": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "endpoint_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "api_token_env": {
          "$ref": "#/$defs/EnvKey"
        },
        "deployment_id_env": {
          "$ref": "#/$defs/EnvKey"
        }
      },
      "required": [
        "endpoint_env",
        "api_token_env",
        "deployment_id_env"
      ]
    }
  }
}
