{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-locks-and-leases/contracts/local-file/json-schema/contract.schema.json",
  "$comment": "Portable local filesystem lock contract — independent JSON Schema authority. Peer of ../typespec/main.tsp; neither is generated from the other. LocalFileLockInspection uses anyOf because its state const discriminators make the branches mutually exclusive while matching the TypeSpec union semantics without oneOf evaluation overhead.",
  "x-ores-namespace": "Ores.LocksAndLeases.LocalFile",
  "$defs": {
    "LocalFileLockPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "LocalFileLockOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "LocalFileLockErrorKind": {
      "type": "string",
      "enum": [
        "contention",
        "timeout",
        "compromised",
        "io",
        "invalid_input"
      ]
    },
    "LocalFileLockInspectionState": {
      "type": "string",
      "enum": ["absent", "held", "incomplete", "compromised"]
    },
    "LocalFileLockInspectionReason": {
      "type": "string",
      "enum": [
        "owner_marker_missing",
        "path_not_directory",
        "dirty_directory",
        "owner_not_regular_file",
        "owner_too_large",
        "owner_invalid_utf8",
        "owner_identity_changed",
        "permissions_widened",
        "owner_contract_violation"
      ]
    },
    "ScopedLocalFileLockOutcomeKind": {
      "type": "string",
      "enum": ["success", "lock_error", "work_error", "work_and_release_error"]
    },
    "LocalFileLockOptions": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "wait": { "type": "boolean" },
        "waitTimeoutMs": { "type": "integer", "minimum": 0 },
        "retryIntervalMs": { "type": "integer", "minimum": 0 }
      },
      "required": ["wait", "waitTimeoutMs", "retryIntervalMs"]
    },
    "LocalFileLockIdentity": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/LocalFileLockPath" },
        "owner": { "$ref": "#/$defs/LocalFileLockOwner" }
      },
      "required": ["path", "owner"]
    },
    "LocalFileLockSnapshot": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/LocalFileLockPath" },
        "owner": { "$ref": "#/$defs/LocalFileLockOwner" },
        "released": { "type": "boolean" }
      },
      "required": ["path", "owner", "released"]
    },
    "LocalFileLockInspection": {
      "anyOf": [
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "state": { "const": "absent" }
          },
          "required": ["state"]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "state": { "const": "held" },
            "owner": { "$ref": "#/$defs/LocalFileLockOwner" }
          },
          "required": ["state", "owner"]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "state": { "const": "incomplete" },
            "reason": { "const": "owner_marker_missing" },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["state", "reason", "message"]
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "state": { "const": "compromised" },
            "reason": { "$ref": "#/$defs/LocalFileLockInspectionReason" },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["state", "reason", "message"]
        }
      ]
    },
    "LocalFileLockRecoveryRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/LocalFileLockPath" },
        "expectedOwner": { "$ref": "#/$defs/LocalFileLockOwner" },
        "confirmedInactive": { "type": "boolean" }
      },
      "required": ["path", "expectedOwner", "confirmedInactive"]
    },
    "LocalFileLockRecoveryResult": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "recovered": { "type": "boolean" }
      },
      "required": ["recovered"]
    },
    "ScopedLocalFileLockOutcome": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/ScopedLocalFileLockOutcomeKind" }
      },
      "required": ["kind"]
    },
    "LocalFileLockFailure": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/LocalFileLockErrorKind" },
        "path": { "$ref": "#/$defs/LocalFileLockPath" },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "path", "message"]
    }
  }
}
